# Copy to .env and fill in: cp .env.example .env
# docker-compose.yml reads these; `make` reads POSTGRES_PASSWORD for tests.

# Released image to run (pin a version for production; see the GitHub
# releases). Add -ffmpeg for the variant with ffmpeg, e.g. v0.1.0-ffmpeg.
MMP_IMAGE=ghcr.io/justdr00py/mmp:latest

# Postgres password for the mmp role, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Address players use to reach MMP (LAN IP or domain, not localhost).
MMP_BASE_URL=http://192.168.1.10:8080

# First admin, created only when no admin exists yet.
MMP_ADMIN_USERNAME=admin
MMP_ADMIN_PASSWORD='change-me-too'

# ---------------------------------------------------------------------------
# VPN (only for docker-compose.vpn.yml; ignored by docker-compose.yml)
# MMP's outgoing traffic goes through gluetun. Full option list:
# https://github.com/qdm12/gluetun-wiki (setup/providers/<your provider>.md)
# ---------------------------------------------------------------------------

# Your VPN provider as gluetun names it, e.g. mullvad, nordvpn, protonvpn,
# surfshark, private internet access, expressvpn, ivpn, windscribe, airvpn.
#VPN_SERVICE_PROVIDER=mullvad

# wireguard (faster, lighter) or openvpn. Not every provider supports both
# in gluetun; the wiki page for your provider says which.
#VPN_TYPE=wireguard

# --- WireGuard: from your provider's WireGuard config file ---
# [Interface] PrivateKey
#WIREGUARD_PRIVATE_KEY=
# [Interface] Address (IPv4 only is safest), e.g. 10.64.222.21/32
#WIREGUARD_ADDRESSES=
# [Peer] PresharedKey, only if your config has one
#WIREGUARD_PRESHARED_KEY=
# auto, kernelspace or userspace. Rootless Podman may need userspace.
#WIREGUARD_IMPLEMENTATION=auto

# --- OpenVPN: the service credentials from your provider's dashboard ---
# (often different from your website login)
#OPENVPN_USER=
#OPENVPN_PASSWORD=

# --- Server choice (comma-separated; blank = any) ---
# Pick a location close to your IPTV providers for the best speeds.
#SERVER_COUNTRIES=Netherlands
#SERVER_CITIES=Amsterdam
#SERVER_HOSTNAMES=

# --- Networking (defaults normally fine) ---
# Private network shared by postgres and gluetun, and postgres' address on
# it. Change both only if 172.29.0.0/24 clashes with a network you use.
#MMP_BACKEND_SUBNET=172.29.0.0/24
#MMP_POSTGRES_IP=172.29.0.10
# Networks MMP may reach outside the tunnel. Must include the subnet above;
# add your LAN (e.g. ,192.168.1.0/24) only if a provider runs on your LAN.
#VPN_OUTBOUND_SUBNETS=172.29.0.0/24
# Host ports, if 8080 or 5432 are taken (MMP_BASE_URL must use the same port).
#MMP_HTTP_PORT=8080
#MMP_POSTGRES_PORT=5432
# Time zone for gluetun's logs.
#TZ=Europe/London
